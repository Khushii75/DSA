#include <bits/stdc++.h>
using namespace std;
int main() {
    int t; cin >> t;
    while (t--) {
        int n; cin >> n;
        int fives = n;
        while (fives % 3 != 0) fives -= 5;
        if (fives < 0) cout << -1 << "\n";
        else cout << string(fives, '5') + string(n - fives, '3') << "\n";
    }
}
