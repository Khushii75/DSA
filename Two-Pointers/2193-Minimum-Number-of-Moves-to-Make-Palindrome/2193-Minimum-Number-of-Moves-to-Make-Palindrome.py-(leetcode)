class Solution(object):
    def minMovesToMakePalindrome(self, s):
        """
        :type s: str
        :rtype: int
        """
        s=list(s)
        i=0
        j=len(s)-1
        ans=0
        while i<j:
            k=j
            while k>i and s[i]!=s[k]:
                k-=1
            if k==i:
                s[i],s[i+1]=s[i+1],s[i]
                ans+=1
            else:
                while k<j:
                    s[k],s[k+1]=s[k+1],s[k]
                    k+=1
                    ans+=1
                i+=1
                j-=1
        return ans