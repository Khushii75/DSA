class Solution:
    def minDis(self, arr, mid):
        
        c=1
        last=arr[0]
        for i in range(1,len(arr)):
            if arr[i]-last>=mid:
                c+=1
                last=arr[i]
        return c
                
    def aggressiveCows(self, arr, k):
        # code here
        n=len(arr)
        arr.sort()
        l=1
        h=arr[n-1]-arr[0]
        while l<=h:
            mid=(l+h)//2
            cows=self.minDis(arr,mid)
            if cows>=k:
                l=mid+1
            else:
                h=mid-1
        return h
                