class Solution:
    def checkOverlap(self, radius: int, xCenter: int, yCenter: int, x1: int, y1: int, x2: int, y2: int) -> bool:

        if x1>xCenter:
            xClo=x1
        elif x2<xCenter:
            xClo=x2
        else:
            xClo=xCenter
        
        if y1>yCenter:
            yClo=y1
        elif y2<yCenter:
            yClo=y2
        else:
            yClo=yCenter

        xDis= xClo-xCenter
        yDis= yClo-yCenter

        return xDis*xDis + yDis*yDis <= radius*radius
    