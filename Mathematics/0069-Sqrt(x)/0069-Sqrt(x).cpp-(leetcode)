class Solution {
public:
    int binarySearch(int n){
        long long int ans=-1;
        int s=0, e=n;
        if(n==0 || n==1) return n;
        while(s<=e){
           long long int mid=s+(e-s)/2;
            long long int square =mid*mid;
            
            if(square==n) return mid;
            if(square<n){
                ans=mid;
                s=mid+1;
            }
            else{
                e=mid-1;
                
            }
        }
        return ans;
    }
    int mySqrt(int x) {
        return binarySearch(x);

        
    }
};