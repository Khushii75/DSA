def lcmAndGcd(self, a : int, b : int) -> List[int]:
# code here
lst=[]

for i in range(1,a*b):
multiple=a*i

if multiple%b == 0:
LCM=multiple
break

lst_gcd=[]
for i in range(1,min(a,b)+1):
