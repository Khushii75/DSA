class Solution:
    def root(self, n, mid):
        num=1
        for i in range(n):
            num *= mid
        return num
        
    def nthRoot(self, n, m):
       # code here
        low=0
        high=m
        if n==1:
            return m
        if m==1:
            return 1
        while low<=high:
            mid=(low+high)//2
            number = self.root(n, mid)
            if number == m:
               return mid
            elif number>m:
                high = mid-1
            else:
                low=mid+1
        return -1
                
           
           
           
               
        
       
