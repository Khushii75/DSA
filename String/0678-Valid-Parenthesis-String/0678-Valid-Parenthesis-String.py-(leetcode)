class Solution(object):
    def checkValidString(self, s):
        """
        :type s: str
        :rtype: bool
        """
        l=0
        h=0
        for i in range(len(s)):
            if s[i]=='(':
                l+=1
                h+=1
            
            elif s[i]==')':
                l-=1
                h-=1

            else:
                l-=1
                h+=1
            if h<0:
                return False
            l=max(0,l)
        return l==0
                
        