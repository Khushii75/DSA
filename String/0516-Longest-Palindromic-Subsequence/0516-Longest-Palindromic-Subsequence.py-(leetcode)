class Solution(object):
    def lcs(self, t1, t2):
        n=len(t1)
        m=len(t2)
        t= [[0 for _ in range(m+1)] for _ in range(n+1)]
        for i in range(1, n+1):
            for j in range(1, m+1):
                if t1[i-1]==t2[j-1]:
                    t[i][j]=1 + t[i-1][j-1]
                else:
                    t[i][j]=max(t[i-1][j], t[i][j-1])
        return t[n][m]
    def longestPalindromeSubseq(self, s):
        """
        :type s: str
        :rtype: int
        """
        rev=s[::-1]
        return self.lcs(s,rev)

        