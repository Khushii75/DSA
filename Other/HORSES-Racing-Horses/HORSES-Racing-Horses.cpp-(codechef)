#include <bits/stdc++.h>
using namespace std;
int main() {
    int t; cin >> t;
    while (t--) {
        int n; cin >> n;
        vector<long long> s(n);
        for (auto &x : s) cin >> x;
        sort(s.begin(), s.end());
        long long minDiff = LLONG_MAX;
        for (int i = 1; i < n; i++)
            minDiff = min(minDiff, s[i] - s[i - 1]);
        cout << minDiff << "\n";
    }
}