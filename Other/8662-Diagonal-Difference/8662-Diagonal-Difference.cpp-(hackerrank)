#include <bits/stdc++.h>
using namespace std;

int main(){
    int n;
    cin >> n;
    
    vector<vector<int>> arr(n, vector<int>(n));
    for(int i = 0; i < n; i++){
        for(int j = 0; j < n; j++){
            cin >> arr[i][j];
        }
    }
    
    int primaryDiag = 0, secondaryDiag = 0;
    for(int i = 0; i < n; i++){
        primaryDiag += arr[i][i];
        secondaryDiag += arr[i][n-1-i];
    }
    
    cout << abs(primaryDiag - secondaryDiag) << endl;
    
    return 0;
}
