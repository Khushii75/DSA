#include <bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin >> t;
    
    while(t--){
        long long n;
        cin >> n;
        
        long long lastDigit = n % 10;
        
        while(n >= 10){
            n /= 10;
        }
        long long firstDigit = n;
        
        cout << firstDigit + lastDigit << endl;
    }
    
    return 0;
}