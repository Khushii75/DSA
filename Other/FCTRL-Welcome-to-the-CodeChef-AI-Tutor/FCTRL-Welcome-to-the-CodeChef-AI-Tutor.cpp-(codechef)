#include <bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin >> t;
    
    while(t--){
        long long n;
        cin >> n;
        
        long long count = 0;
        for(long long p = 5; p <= n; p *= 5){
            count += n / p;
        }
        
        cout << count << endl;
    }
    
    return 0;
}