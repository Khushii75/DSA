class Solution(object):
    def dfs(self, i, j, vis , grid):
        if i<0 or i>=len(grid) or j<0 or j>=len(grid[0]):
            return 0
        if grid[i][j]==0:
            return 0
        if vis[i][j]==-1:
            return 0
        vis[i][j]=-1
        total=grid[i][j]
        total += self.dfs(i+1, j, vis, grid)
        total += self.dfs(i-1, j, vis, grid)
        total += self.dfs(i, j+1, vis, grid)
        total += self.dfs(i, j-1, vis, grid)
        return total
    def countIslands(self, grid, k):

        """
        :type grid: List[List[int]]
        :type k: int
        :rtype: int
        """
        row=len(grid)
        col=len(grid[0])
        vis = [[0 for _ in range(col)] for _ in range(row)]
        cnt=0
      
        for r in range(row):
            for c in range(col):
                if grid[r][c] > 0 and vis[r][c] == 0:
                    total = self.dfs(r, c, vis, grid)  # Fix 2
                    if total % k == 0:                 # Fix 3
                        cnt += 1
               
        return cnt


        