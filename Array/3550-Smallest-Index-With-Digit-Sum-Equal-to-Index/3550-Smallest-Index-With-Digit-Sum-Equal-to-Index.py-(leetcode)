class Solution(object):
    def sumD(self, x):
        sum=0
        while x>0:
            sum+=x%10
            x=x//10
        return sum
    def smallestIndex(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        for i in range(len(nums)):
            if self.sumD(nums[i])==i:
                return i
        return -1
        