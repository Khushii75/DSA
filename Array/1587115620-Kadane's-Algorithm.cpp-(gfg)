class Solution:
    def maxSubarraySum(self, arr): 

        # kanade's Algorithm

        # store result 
        res = arr[0]
        # maximum continous sub-array 
        maxEnding = arr[0]
        for i in range(1,len(arr)):
            # here check continous with max sum if we found it or create new sub array 
            maxEnding = max(maxEnding + arr[i] , arr[i])
            # update result if new subarray was largeser
            res = max(res, maxEnding)
        return res