#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        string s;
        cin >> s;
        
        int a = (s[0]-'0')*10 + (s[1]-'0');
        int b = (s[3]-'0')*10 + (s[4]-'0');
        
        bool ddmm = (a >= 1 && a <= 31) && (b >= 1 && b <= 12);
        bool mmdd = (a >= 1 && a <= 12) && (b >= 1 && b <= 31);
        
        if (ddmm && mmdd) {
            cout << "BOTH" << "\n";
        } else if (ddmm) {
            cout << "DD/MM/YYYY" << "\n";
        } else {
            cout << "MM/DD/YYYY" << "\n";
        }
    }
    return 0;
}